# Copy this file to .env and fill in the values. run_experiment.py loads .env at
# start-up; variables already exported in your shell take precedence. .env is
# gitignored — never commit real credentials.

# Default model access (provider = "openai" in config.toml)
OPENAI_API_KEY=

# For Anthropic models (provider = "anthropic" in config.toml)
# ANTHROPIC_API_KEY=

# For a custom endpoint / evaluation relay: whatever variable name you declared
# as "apiKey" in pi-agent/models.json (see README "Model access")
# TRACES_EPISODE_TOKEN=
